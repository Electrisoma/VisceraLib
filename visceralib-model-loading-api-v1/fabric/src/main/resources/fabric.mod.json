{
  "schemaVersion": 1,
  "id": "visceralib_model_loading_api_v1",
  "version": "${version}",
  "name": "VisceraLib Model Loading API (v1)",
  "description": "Contains code to help with loading different model formats.",
  "authors": [ "${authors}" ],
  "contributors": [ "${contributors}" ],
  "contact": {
    "homepage": "${github}",
    "sources": "${github}",
    "issues": "${github}/issues"
  },
  "license": "${license}",
  "icon": "assets/visceralib_model_loading_api_v1/logo.png",
  "environment": "client",
  "entrypoints": {
    "client": [ "net.electrisoma.visceralib.impl.model.loading.v1.client.ClientEntrypointFabric" ]
  },
  "mixins": [
    "mixins/visceralib-model-loading-api-v1-common.client.mixins.json",
    "mixins/visceralib-model-loading-api-v1-fabric.client.mixins.json"
  ],
  "depends": {
    "visceralib_core": "*",
    "fabric-api-base": "*",
    "fabricloader": ">=${fabric}",
    "minecraft": "${minecraft}",
    "java": ">=${java}"
  },
  "custom": {
    "modmenu": {
      "badges": [ "library" ],
      "parent": {
        "id": "visceralib",
        "name": "VisceraLib",
        "description": "${description}",
        "icon": "assets/visceralib_model_loading_api_v1/logo.png",
        "badges": [ "library" ]
      },
      "update_checker": true
    }
  }
}