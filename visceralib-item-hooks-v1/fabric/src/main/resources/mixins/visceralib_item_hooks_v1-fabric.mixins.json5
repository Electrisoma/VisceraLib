{
  package: "net.electrisoma.visceralib.mixin.item.v1",
  required: true,
  minVersion: "0.8",
  compatibilityLevel: "${compatibilityLevel}",
  injectors: { defaultRequire: 1 },
  mixins: [
    "IFabricItemMixin",
    "PiglinAiMixin",
    "ItemStackMixin",
    "LivingEntityMixin",
    "ItemEntityMixin",
    "PlayerMixin",
    "EnchantmentHelperMixin",
    "ArmorSlotMixin",
    "AnvilMenuMixin",
    "ServerLevelMixin"
  ]
}
